            android:label="@string/title_navi_settings_activity"
            android:name="ru.zinovin.tankspeedometer.preferences.NaviSettingsActivity"
            android:exported="false"/>
        <activity
            android:label="@string/title_music_settings_activity"
            android:name="ru.zinovin.tankspeedometer.preferences.MusicSettingsActivity"
