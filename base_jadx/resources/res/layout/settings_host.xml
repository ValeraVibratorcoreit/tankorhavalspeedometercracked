<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ts_root"
    android:background="@color/ts_color_bg_app"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="start"
        android:id="@+id/ts_item_list"
        android:background="@color/ts_color_bg_sidebar"
        android:paddingTop="@dimen/ts_topbar_height"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="@dimen/ts_sidebar_width"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ru.zinovin.tankspeedometer.preferences.widget.SettingsTopBar
            android:id="@+id/ts_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/ts_item_detail_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/ts_sidebar_width"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ts_fragment_content_second"
        android:background="@color/ts_color_bg_app"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
