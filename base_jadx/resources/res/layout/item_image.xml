<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ts_bg_theme_card"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/item_image"
        android:layout_width="340dp"
        android:layout_height="128dp"
        android:src="@color/accent"/>
    <TextView
        android:textSize="@dimen/ts_text_primary"
        android:textColor="@color/ts_color_text_primary"
        android:id="@+id/item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Text"
        android:layout_marginStart="20dp"
        android:layout_toEndOf="@+id/item_image"/>
    <TextView
        android:textSize="@dimen/ts_text_secondary"
        android:textColor="@color/ts_color_text_secondary"
        android:id="@+id/item_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desc"
        android:singleLine="false"
        android:maxLength="50"
        android:layout_below="@+id/item_text"
        android:layout_marginStart="20dp"
        android:layout_toEndOf="@+id/item_image"/>
    <ImageButton
        android:id="@+id/btn_delete"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ts_ic_delete"
        android:layout_centerVertical="true"
        android:contentDescription="@string/text_delete_btn"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
