<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hud_main"
    android:background="@android:color/transparent"
    android:padding="0dp"
    android:visibility="invisible"
    android:layout_width="320dp"
    android:layout_height="260dp"
    android:layout_marginTop="178dp">
    <ImageView
        android:id="@+id/hud_image"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="36dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="72sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/hud_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        app:layout_constraintStart_toEndOf="@+id/hud_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/hud_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        app:layout_constraintEnd_toEndOf="@+id/hud_distance"
        app:layout_constraintStart_toStartOf="@+id/hud_distance"
        app:layout_constraintTop_toBottomOf="@+id/hud_distance"/>
    <TextView
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/hud_street"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hud_unit"/>
</androidx.constraintlayout.widget.ConstraintLayout>
