<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/leftline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="106dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/rightline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="128dp"/>
    <include
        android:id="@+id/fuelBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/odoTotal"
        app:layout_constraintStart_toEndOf="@+id/leftline"
        app:layout_constraintTop_toTopOf="@+id/odoTotal"
        layout="@layout/fuel_block_combo_night"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textColor="@color/text_night_main"
        android:gravity="center_vertical"
        android:id="@+id/odoTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="888888 km"
        android:fontFamily="@font/parsi_light"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fuelBlock"/>
    <include
        android:id="@+id/coolantBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/odoTotal"
        app:layout_constraintEnd_toStartOf="@+id/rightline"
        app:layout_constraintTop_toTopOf="@+id/odoTotal"
        layout="@layout/coolant_block_small_night"/>
</androidx.constraintlayout.widget.ConstraintLayout>
