<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/ts_tab_layout"
        android:background="@color/ts_color_bg_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingStart="16dp"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/ts_color_gwm"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="6dp"
        app:tabMaxWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingBottom="18dp"
        app:tabSelectedTextColor="@color/ts_color_text_primary"
        app:tabTextAppearance="@style/TsTabTextAppearance"
        app:tabTextColor="@color/ts_color_text_secondary"/>
    <FrameLayout
        android:id="@+id/ts_tab_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
