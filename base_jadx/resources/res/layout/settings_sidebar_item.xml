<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ts_bg_sidebar_item"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/ts_sidebar_item_height"
    android:paddingStart="20dp"
    android:paddingEnd="12dp">
    <ImageView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/ts_item_icon"
        android:layout_width="@dimen/ts_sidebar_icon"
        android:layout_height="@dimen/ts_sidebar_icon"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"
        app:tint="@color/ts_sidebar_title_color"/>
    <TextView
        android:textSize="@dimen/ts_text_primary"
        android:textColor="@color/ts_sidebar_title_color"
        android:ellipsize="end"
        android:id="@+id/ts_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_weight="1"/>
</LinearLayout>
