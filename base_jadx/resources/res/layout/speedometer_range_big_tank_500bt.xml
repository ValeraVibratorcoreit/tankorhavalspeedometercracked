<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="1442dp"
    android:layout_height="540dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/naviBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/line_top1"
        android:background="@drawable/range_line_short"
        android:layout_width="900dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/header_block_tank_500_range"/>
    <include
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/footer_block_tank_500bt_range"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageLeftMeter"
        android:layout_width="520dp"
        android:layout_height="520dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_withTremble="false"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageRightMeter"
        android:layout_width="520dp"
        android:layout_height="520dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_withTremble="false"/>
    <ru.zinovin.tankspeedometer.view.RangeFuelLevelIndicatorView
        android:id="@+id/leftLevelIndicator"
        android:layout_width="520dp"
        android:layout_height="520dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:rv_endDegree="124"
        app:rv_startDegree="95"/>
    <ru.zinovin.tankspeedometer.view.RangeFuelLevelIndicatorView
        android:id="@+id/leftLevelIndicator2"
        android:layout_width="520dp"
        android:layout_height="520dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:rv_endDegree="85"
        app:rv_startDegree="56"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageLeftSubmeter"
        android:layout_width="520dp"
        android:layout_height="520dp"
        app:backgroundDrawable="@drawable/range_fuel_double"
        app:endAngle="195"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:maxValue="100"
        app:startAngle="214"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_withTremble="false"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageLeftSubmeter2"
        android:layout_width="520dp"
        android:layout_height="520dp"
        app:endAngle="146"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:maxValue="100"
        app:startAngle="175"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_withTremble="false"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/range_text"
        android:id="@+id/fuel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="80 L"
        android:fontFamily="@font/frutiger"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftSubmeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftSubmeter"
        app:layout_constraintHorizontal_bias="0.41"
        app:layout_constraintStart_toStartOf="@+id/imageLeftSubmeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftSubmeter"
        app:layout_constraintVertical_bias="0.84"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/range_text"
        android:id="@+id/fuel_sec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50 L"
        android:fontFamily="@font/frutiger"
        app:layout_constraintBottom_toBottomOf="@+id/fuel"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftSubmeter"
        app:layout_constraintHorizontal_bias="0.585"
        app:layout_constraintStart_toStartOf="@+id/imageLeftSubmeter"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageRightSubmeter"
        android:layout_width="520dp"
        android:layout_height="520dp"
        app:backgroundDrawable="@drawable/range_coolant"
        app:endAngle="148"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:maxValue="130"
        app:minValue="50"
        app:startAngle="212"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_withTremble="false"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/range_text"
        android:id="@+id/coolant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100°C"
        android:fontFamily="@font/frutiger"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightSubmeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightSubmeter"
        app:layout_constraintHorizontal_bias="0.54"
        app:layout_constraintStart_toStartOf="@+id/imageRightSubmeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightSubmeter"
        app:layout_constraintVertical_bias="0.855"/>
    <ImageView
        android:id="@+id/logoRight"
        android:visibility="invisible"
        android:layout_width="@dimen/logoWidth"
        android:layout_height="@dimen/logoHeight"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:layout_constraintVertical_bias="0.3"/>
    <FrameLayout
        android:id="@+id/left_info_container"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:layout_constraintVertical_bias="0.5"/>
    <FrameLayout
        android:id="@+id/right_info_container"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:layout_constraintVertical_bias="0.5"/>
    <FrameLayout
        android:id="@+id/center_info_container"
        android:layout_width="300dp"
        android:layout_height="230dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/centerInfoPanelBiasRange"/>
</androidx.constraintlayout.widget.ConstraintLayout>
