<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@android:color/transparent"
    android:layout_width="1442dp"
    android:layout_height="540dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/naviBorder"
        android:layout_width="1440dp"
        android:layout_height="538dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/leftline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="142dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/rightline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="142dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottomline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintGuide_end="16dp"/>
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@android:color/transparent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/header_block_haval_f7"/>
    <ImageView
        android:id="@+id/micro_footer"
        android:layout_width="match_parent"
        android:layout_height="107px"
        android:src="@drawable/micro_footer_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.zinovin.tankspeedometer.view.GradientCircleView
        android:id="@+id/leftMeterShadow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:gradientColor="#f0000000"
        app:gradientStop="0.5"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"/>
    <ru.zinovin.tankspeedometer.view.GradientCircleView
        android:id="@+id/rightMeterShadow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:gradientColor="#f0000000"
        app:gradientStop="0.5"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageLeftMeter"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="-20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/leftline"
        app:maxValue="240"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_speedTextFormat="INTEGER"
        app:sv_speedTextPosition="CENTER"
        app:sv_speedTextSize="90sp"
        app:sv_speedTextTypeface="fonts/vw_digit_reg.otf"
        app:sv_speedometerMode="NORMAL"
        app:sv_unit="km/h"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_unitTextSize="36sp"
        app:sv_unitUnderSpeedText="true"
        app:sv_withTremble="false"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageRightMeter"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginEnd="-20dp"
        app:layout_constraintEnd_toEndOf="@+id/rightline"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:maxValue="8"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_speedTextFormat="FLOAT"
        app:sv_speedTextPosition="CENTER"
        app:sv_speedTextSize="90sp"
        app:sv_speedTextTypeface="fonts/vw_digit_reg.otf"
        app:sv_speedometerMode="NORMAL"
        app:sv_unit="rpmx1000"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_unitTextSize="36sp"
        app:sv_unitUnderSpeedText="true"
        app:sv_withTremble="false"/>
    <ImageView
        android:id="@+id/imageLeftBottom"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="-2dp"
        android:layout_marginStart="-1dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"/>
    <ImageView
        android:id="@+id/imageRightBottom"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="-2dp"
        android:layout_marginStart="-1dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"/>
    <FrameLayout
        android:id="@+id/left_info_container"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"/>
    <FrameLayout
        android:id="@+id/right_info_container"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"/>
    <FrameLayout
        android:id="@+id/center_info_container"
        android:layout_width="300dp"
        android:layout_height="230dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/centerInfoPanelBias"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/fuel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="88 L"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/coolant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="000 °C"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/fuel"/>
    <ImageView
        android:id="@+id/imageFuel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/fuel_icon_kia"
        app:layout_constraintBottom_toBottomOf="@+id/remainOdometer"
        app:layout_constraintEnd_toStartOf="@+id/remainOdometer"
        app:layout_constraintTop_toTopOf="@+id/remainOdometer"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/remainOdometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888 km"
        android:layout_marginEnd="-20dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomline"
        app:layout_constraintEnd_toStartOf="@+id/imageLeftMeter"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/odoTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888888 km"
        android:layout_marginStart="-20dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomline"
        app:layout_constraintStart_toEndOf="@+id/imageLeftMeter"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12.1V"
        app:layout_constraintBottom_toBottomOf="@+id/bottomline"
        app:layout_constraintStart_toEndOf="@+id/rightline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
