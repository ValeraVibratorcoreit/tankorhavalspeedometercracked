<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_night"
        android:gravity="center_vertical"
        android:id="@+id/imageCharE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="E"
        android:fontFamily="@font/parsi_light"
        android:layout_marginStart="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/fuelLevelIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fuelLevelIndicator"/>
    <ru.zinovin.tankspeedometer.view.FuelLevelIndicatorView
        android:id="@+id/fuelLevelIndicator"
        android:layout_width="164dp"
        android:layout_height="@dimen/indicatorHeight"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageCharE"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageFuel"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/fuel_2"
        app:layout_constraintBottom_toTopOf="@+id/fuelLevelIndicator"
        app:layout_constraintEnd_toEndOf="@+id/fuelLevelIndicator"
        app:layout_constraintHorizontal_bias="0.14"
        app:layout_constraintStart_toStartOf="@+id/fuelLevelIndicator"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textColor="@color/text_night_main"
        android:gravity="center_vertical"
        android:id="@+id/remainOdometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888 km"
        android:fontFamily="@font/parsi_light"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageFuel"
        app:layout_constraintStart_toEndOf="@+id/imageFuel"
        app:layout_constraintTop_toTopOf="@+id/imageFuel"
        app:layout_constraintVertical_bias="0.25"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_night"
        android:gravity="center_vertical"
        android:id="@+id/imageCharF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="F"
        android:fontFamily="@font/parsi_light"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/fuelLevelIndicator"
        app:layout_constraintStart_toEndOf="@+id/fuelLevelIndicator"
        app:layout_constraintTop_toTopOf="@+id/fuelLevelIndicator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
