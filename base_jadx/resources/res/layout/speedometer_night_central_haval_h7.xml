<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@android:color/transparent"
    android:layout_width="1442dp"
    android:layout_height="540dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/naviBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/header_block_haval_h7_night"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageLeftMeter"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_marginTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_speedometerMode="NORMAL"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_withTremble="false"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageRightMeter"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginBottom="-64dp"
        android:layout_marginStart="0dp"
        app:layout_constraintBottom_toTopOf="@+id/footer"
        app:layout_constraintStart_toEndOf="@+id/imageLeftMeter"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_speedometerMode="NORMAL"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_withTremble="false"/>
    <ImageView
        android:id="@+id/logoRight"
        android:visibility="invisible"
        android:layout_width="@dimen/logoWidth"
        android:layout_height="@dimen/logoHeight"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:layout_constraintVertical_bias="0.25"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textColor="@color/text_night_main"
        android:id="@+id/battery"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="12.1V"
        android:fontFamily="@font/parsi_light"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:layout_constraintVertical_bias="@fraction/rightInfoPanelBiasNightCenter"/>
    <FrameLayout
        android:id="@+id/center_info_container"
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintHorizontal_bias="@fraction/centerInfoPanelBiasNightCenterHorizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/centerInfoPanelBias"/>
    <include
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/footer_block_haval_h7_night_center"/>
</androidx.constraintlayout.widget.ConstraintLayout>
