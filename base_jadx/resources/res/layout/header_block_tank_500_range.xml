<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/gearTextSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/_tmp"
        android:paddingBottom="6dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="0"
        android:layout_marginStart="740dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/wifiImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/wifi"
        android:layout_marginStart="640dp"
        app:layout_constraintBottom_toBottomOf="@+id/_tmp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/_tmp"
        app:layout_constraintVertical_bias="0"/>
    <TextClock
        android:textSize="@dimen/kiaTextSize"
        android:textColor="@color/white"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/frutiger"
        android:textAlignment="center"
        android:layout_marginEnd="20dp"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        app:layout_constraintBottom_toBottomOf="@+id/_tmp"
        app:layout_constraintEnd_toStartOf="@+id/wifiImg"
        app:layout_constraintTop_toTopOf="@+id/_tmp"/>
    <TextView
        android:textSize="@dimen/kiaTextSize"
        android:textColor="@color/white"
        android:id="@+id/outsideTemp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20"
        android:fontFamily="@font/frutiger"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/_tmp"
        app:layout_constraintTop_toTopOf="@+id/time"/>
    <TextView
        android:textSize="28sp"
        android:textColor="@color/unit_text"
        android:id="@+id/outsideTempText"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="°C"
        android:fontFamily="@font/frutiger"
        app:layout_constraintBottom_toBottomOf="@+id/outsideTemp"
        app:layout_constraintStart_toEndOf="@+id/outsideTemp"
        app:layout_constraintTop_toTopOf="@+id/outsideTemp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
