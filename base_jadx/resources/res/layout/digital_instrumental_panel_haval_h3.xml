<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@android:color/transparent"
    android:layout_width="1442dp"
    android:layout_height="540dp">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@android:color/transparent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/header_block_haval_h3"/>
    <ru.zinovin.tankspeedometer.view.GradientCircleView
        android:layout_width="360dp"
        android:layout_height="360dp"
        app:layout_constraintBottom_toBottomOf="@+id/speed"
        app:layout_constraintEnd_toEndOf="@+id/speed"
        app:layout_constraintStart_toStartOf="@+id/speed"
        app:layout_constraintTop_toTopOf="@+id/speed"
        app:layout_constraintVertical_bias="0.4"/>
    <ru.zinovin.tankspeedometer.view.GradientCircleView
        android:layout_width="360dp"
        android:layout_height="360dp"
        app:layout_constraintBottom_toBottomOf="@+id/rpm"
        app:layout_constraintEnd_toEndOf="@+id/rpm"
        app:layout_constraintStart_toStartOf="@+id/rpm"
        app:layout_constraintTop_toTopOf="@+id/speed"
        app:layout_constraintVertical_bias="0.4"/>
    <TextView
        android:textSize="90sp"
        android:textColor="@color/speed_text"
        android:gravity="center_horizontal"
        android:id="@+id/speed"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:text="188"
        android:fontFamily="@font/vw_digit_reg"
        android:layout_marginStart="148dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.46"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/unit_text"
        android:id="@+id/leftMeterText"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:layout_marginTop="2dp"
        android:text="km/h"
        app:layout_constraintEnd_toEndOf="@+id/speed"
        app:layout_constraintStart_toStartOf="@+id/speed"
        app:layout_constraintTop_toBottomOf="@+id/speed"/>
    <TextView
        android:textSize="90sp"
        android:textColor="@color/speed_text"
        android:gravity="center_horizontal"
        android:id="@+id/rpm"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="8.8"
        android:fontFamily="@font/vw_digit_reg"
        android:layout_marginEnd="148dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/speed"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/unit_text"
        android:id="@+id/rightMeterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="rpmx1000"
        app:layout_constraintEnd_toEndOf="@+id/rpm"
        app:layout_constraintStart_toStartOf="@+id/rpm"
        app:layout_constraintTop_toBottomOf="@+id/rpm"/>
    <FrameLayout
        android:id="@+id/center_info_container"
        android:layout_width="300dp"
        android:layout_height="230dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/centerInfoPanelBias"/>
    <include
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/footer_block_haval_h3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
