<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/leftline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="106dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/rightline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="145dp"/>
    <TextView
        android:textSize="@dimen/kiaTextSize"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/fuel"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="88 L"
        android:fontFamily="@font/plau_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/leftline"/>
    <ImageView
        android:id="@+id/imageFuel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/fuel_icon_kia"
        android:layout_marginStart="495dp"
        app:layout_constraintBottom_toBottomOf="@+id/remainOdometer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/remainOdometer"/>
    <TextView
        android:textSize="@dimen/kiaTextSize"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/remainOdometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888 km"
        android:fontFamily="@font/plau_medium"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/imageFuel"
        app:layout_constraintTop_toTopOf="@+id/fuel"/>
    <TextView
        android:textSize="@dimen/kiaTextSize"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/odoTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888888 km"
        android:fontFamily="@font/plau_medium"
        android:layout_marginEnd="520dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fuel"/>
    <TextView
        android:textSize="@dimen/headerTextSize"
        android:textStyle="bold"
        android:id="@+id/battery"
        android:layout_width="98dp"
        android:layout_height="24dp"
        android:layout_marginBottom="0dp"
        android:text="12.1V"
        android:fontFamily="@font/plau_medium"
        app:layout_constraintBottom_toTopOf="@+id/evBattery"
        app:layout_constraintStart_toEndOf="@+id/rightline"/>
    <TextView
        android:textSize="@dimen/headerTextSize"
        android:textStyle="bold"
        android:id="@+id/evBattery"
        android:layout_width="98dp"
        android:layout_height="24dp"
        android:layout_marginBottom="16dp"
        android:text="48.8%"
        android:fontFamily="@font/plau_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rightline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
