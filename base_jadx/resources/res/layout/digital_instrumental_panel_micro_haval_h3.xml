<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@android:color/transparent"
    android:layout_width="1442dp"
    android:layout_height="540dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/naviBorder"
        android:layout_width="1440dp"
        android:layout_height="538dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/leftline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="142dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/rightline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="142dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottomline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintGuide_end="36dp"/>
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@android:color/transparent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/header_block_haval_h3"/>
    <ru.zinovin.tankspeedometer.view.GradientCircleView
        android:id="@+id/leftMeterShadow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:gradientColor="#f0000000"
        app:gradientStop="0.4"
        app:layout_constraintBottom_toBottomOf="@+id/speed"
        app:layout_constraintEnd_toEndOf="@+id/speed"
        app:layout_constraintStart_toStartOf="@+id/speed"
        app:layout_constraintTop_toTopOf="@+id/speed"/>
    <ru.zinovin.tankspeedometer.view.GradientCircleView
        android:id="@+id/rightMeterShadow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:gradientColor="#f0000000"
        app:gradientStop="0.4"
        app:layout_constraintBottom_toBottomOf="@+id/rpm"
        app:layout_constraintEnd_toEndOf="@+id/rpm"
        app:layout_constraintStart_toStartOf="@+id/rpm"
        app:layout_constraintTop_toTopOf="@+id/rpm"/>
    <TextView
        android:textSize="70sp"
        android:textColor="@color/speed_text"
        android:gravity="center_horizontal"
        android:id="@+id/speed"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="85dp"
        android:text="288"
        android:fontFamily="@font/vw_digit_reg"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/leftline"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/unit_text"
        android:id="@+id/leftMeterText"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:layout_marginTop="2dp"
        android:text="km/h"
        app:layout_constraintEnd_toEndOf="@+id/speed"
        app:layout_constraintStart_toStartOf="@+id/speed"
        app:layout_constraintTop_toBottomOf="@+id/speed"/>
    <TextView
        android:textSize="70sp"
        android:textColor="@color/speed_text"
        android:gravity="center_horizontal"
        android:id="@+id/rpm"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="8.8"
        android:fontFamily="@font/vw_digit_reg"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="@+id/rightline"
        app:layout_constraintTop_toTopOf="@+id/speed"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/unit_text"
        android:id="@+id/rightMeterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="rpmx1000"
        app:layout_constraintEnd_toEndOf="@+id/rpm"
        app:layout_constraintStart_toStartOf="@+id/rpm"
        app:layout_constraintTop_toBottomOf="@+id/rpm"/>
    <FrameLayout
        android:id="@+id/center_info_container"
        android:layout_width="300dp"
        android:layout_height="230dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/centerInfoPanelBias"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/fuel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="88 L"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/speed"
        app:layout_constraintStart_toStartOf="@+id/speed"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/coolant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="000 °C"
        app:layout_constraintEnd_toEndOf="@+id/rpm"
        app:layout_constraintStart_toStartOf="@+id/rpm"
        app:layout_constraintTop_toTopOf="@+id/fuel"/>
    <ImageView
        android:id="@+id/imageFuel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/fuel_icon_kia"
        app:layout_constraintBottom_toBottomOf="@+id/remainOdometer"
        app:layout_constraintEnd_toStartOf="@+id/remainOdometer"
        app:layout_constraintTop_toTopOf="@+id/remainOdometer"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/remainOdometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888 km"
        android:layout_marginEnd="-20dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomline"
        app:layout_constraintEnd_toStartOf="@+id/speed"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/odoTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888888 km"
        android:layout_marginStart="-20dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomline"
        app:layout_constraintStart_toEndOf="@+id/speed"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12.1V"
        app:layout_constraintBottom_toBottomOf="@+id/bottomline"
        app:layout_constraintStart_toEndOf="@+id/rightline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
