<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/constraint_layout"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/info_panel_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/speed_text"
        android:gravity="center_vertical"
        android:id="@+id/title1"
        android:layout_width="wrap_content"
        android:layout_height="18sp"
        android:text="@string/text_trip_title"
        app:layout_constraintBottom_toTopOf="@+id/avgFuelConsJourney"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/speed_text"
        android:gravity="center_vertical"
        android:id="@+id/avgFuelConsJourney"
        android:layout_width="wrap_content"
        android:layout_height="18sp"
        android:layout_marginTop="8dp"
        android:text="29.9"
        app:layout_constraintBottom_toTopOf="@+id/avgSpeedJourney"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.31"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/unit_text"
        android:gravity="center_vertical"
        android:id="@+id/firstParamTxt"
        android:layout_width="wrap_content"
        android:layout_height="18sp"
        android:text="l/100km"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/avgFuelConsJourney"
        app:layout_constraintStart_toEndOf="@+id/avgFuelConsJourney"
        app:layout_constraintTop_toTopOf="@+id/avgFuelConsJourney"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/speed_text"
        android:gravity="center_vertical"
        android:id="@+id/avgSpeedJourney"
        android:layout_width="wrap_content"
        android:layout_height="18sp"
        android:layout_marginTop="8dp"
        android:text="139"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/avgFuelConsJourney"
        app:layout_constraintTop_toBottomOf="@+id/avgFuelConsJourney"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/unit_text"
        android:gravity="center_vertical"
        android:id="@+id/secondParamTxt"
        android:layout_width="wrap_content"
        android:layout_height="18sp"
        android:text="km/h"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/avgSpeedJourney"
        app:layout_constraintStart_toEndOf="@+id/avgSpeedJourney"
        app:layout_constraintTop_toTopOf="@+id/avgSpeedJourney"/>
    <ImageView
        android:id="@+id/imageFirst"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/fuel_consume"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/avgFuelConsJourney"
        app:layout_constraintEnd_toStartOf="@+id/avgFuelConsJourney"
        app:layout_constraintTop_toTopOf="@+id/avgFuelConsJourney"/>
    <ImageView
        android:id="@+id/imageSecond"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/indicator_2"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/avgSpeedJourney"
        app:layout_constraintEnd_toStartOf="@+id/avgSpeedJourney"
        app:layout_constraintTop_toTopOf="@+id/avgSpeedJourney"/>
</androidx.constraintlayout.widget.ConstraintLayout>
