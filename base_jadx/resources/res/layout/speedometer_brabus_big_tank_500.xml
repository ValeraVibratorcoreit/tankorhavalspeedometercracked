<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="1442dp"
    android:layout_height="540dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/naviBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/line_top1"
        android:background="@drawable/brabus_line_top"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
    <ImageView
        android:id="@+id/line_bottom"
        android:background="@drawable/brabus_line_bottom"
        android:visibility="visible"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-36dp"
        app:layout_constraintBottom_toTopOf="@+id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/header_block_tank_500_brabus"/>
    <FrameLayout
        android:id="@+id/leftLevelIndicator"
        android:layout_width="500dp"
        android:layout_height="500dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"/>
    <FrameLayout
        android:id="@+id/rightLevelIndicator"
        android:layout_width="500dp"
        android:layout_height="500dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageLeftMeter"
        android:visibility="visible"
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:endAngle="394"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:maxValue="220"
        app:startAngle="146"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_speedTextFormat="INTEGER"
        app:sv_speedTextPosition="CENTER"
        app:sv_speedTextSize="90sp"
        app:sv_speedTextTypeface="fonts/vw_digit_reg.otf"
        app:sv_speedometerMode="NORMAL"
        app:sv_unit="km/h"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_unitTextSize="36sp"
        app:sv_unitUnderSpeedText="true"
        app:sv_withTremble="false"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageRightMeter"
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_marginEnd="16dp"
        app:endAngle="394"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:maxValue="8"
        app:startAngle="146"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_speedTextFormat="FLOAT"
        app:sv_speedTextPosition="CENTER"
        app:sv_speedTextSize="90sp"
        app:sv_speedTextTypeface="fonts/vw_digit_reg.otf"
        app:sv_speedometerMode="NORMAL"
        app:sv_unit="rpmx1000"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_unitTextSize="36sp"
        app:sv_unitUnderSpeedText="true"
        app:sv_withTremble="false"/>
    <ImageView
        android:id="@+id/logoRight"
        android:visibility="invisible"
        android:layout_width="@dimen/logoWidth"
        android:layout_height="@dimen/logoHeight"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:layout_constraintVertical_bias="0.35"/>
    <ImageView
        android:id="@+id/left_label"
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:src="@drawable/name_brabus_tank_001"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"/>
    <ImageView
        android:id="@+id/right_label"
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:src="@drawable/name_brabus_v6biturbo_001"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"/>
    <FrameLayout
        android:id="@+id/left_info_container"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:layout_constraintVertical_bias="0.55"/>
    <FrameLayout
        android:id="@+id/right_info_container"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:layout_constraintVertical_bias="0.55"/>
    <FrameLayout
        android:id="@+id/center_info_container"
        android:layout_width="300dp"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/centerInfoPanelBias"/>
    <ru.zinovin.tankspeedometer.view.BrabusGearBlockFragment
        android:id="@+id/gear_block_brabus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:layout_constraintVertical_bias="0.72"/>
    <include
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/footer_block_tank_500_brabus"/>
</androidx.constraintlayout.widget.ConstraintLayout>
