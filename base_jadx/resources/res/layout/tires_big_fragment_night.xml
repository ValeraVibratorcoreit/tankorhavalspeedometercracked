<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/info_panel_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageCar"
        android:layout_width="93dp"
        android:layout_height="192dp"
        android:src="@drawable/top_view_1_small"
        android:layout_marginStart="73dp"
        android:layout_marginEnd="73dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42"/>
    <TextView
        android:textSize="@dimen/tireBigTextSize"
        android:textColor="@color/text_night_main"
        android:gravity="center_horizontal"
        android:id="@+id/lf_tire_p"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="230"
        android:fontFamily="@font/parsi_light"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toStartOf="@+id/lf_tire_img"
        app:layout_constraintTop_toTopOf="@+id/lf_tire_img"/>
    <TextView
        android:textSize="@dimen/tireBigTempSize"
        android:textStyle="bold"
        android:textColor="@color/text_night_main"
        android:gravity="center_horizontal"
        android:id="@+id/lf_tire_t"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tireTextMargin"
        android:text="/8"
        android:fontFamily="@font/parsi_light"
        app:layout_constraintEnd_toEndOf="@+id/lf_tire_p"
        app:layout_constraintStart_toStartOf="@+id/lf_tire_p"
        app:layout_constraintTop_toBottomOf="@+id/lf_tire_p"/>
    <ImageView
        android:id="@+id/lf_tire_img"
        android:layout_width="15dp"
        android:layout_height="32dp"
        android:layout_marginTop="21dp"
        android:src="@drawable/tire_normal"
        android:layout_marginEnd="-19dp"
        app:layout_constraintEnd_toStartOf="@+id/imageCar"
        app:layout_constraintTop_toTopOf="@+id/imageCar"/>
    <TextView
        android:textSize="@dimen/tireBigTextSize"
