        android:textColor="@color/text_night_main"
        android:gravity="center_horizontal"
        android:id="@+id/lr_tire_t"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tireTextMargin"
