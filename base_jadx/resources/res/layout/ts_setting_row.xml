<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/ts_row_height"
    android:paddingStart="@dimen/ts_row_padding"
    android:paddingEnd="@dimen/ts_row_padding">
    <ImageView
        android:id="@+id/ts_row_icon"
        android:visibility="gone"
        android:layout_width="@dimen/ts_sidebar_icon"
        android:layout_height="@dimen/ts_sidebar_icon"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/ts_text_primary"
            android:textColor="@color/ts_text_primary_color"
            android:ellipsize="end"
            android:id="@+id/ts_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="@dimen/ts_text_secondary"
            android:textColor="@color/ts_color_text_secondary"
            android:ellipsize="end"
            android:id="@+id/ts_row_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ts_row_widget_slot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"/>
</LinearLayout>
