<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/black_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/leftline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="46dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/rightline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="103dp"/>
    <ImageView
        android:id="@+id/imageFuel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/fuel_icon_kia"
        android:layout_marginStart="520dp"
        app:layout_constraintBottom_toBottomOf="@+id/remainOdometer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/remainOdometer"/>
    <TextView
        android:textSize="@dimen/aurusTextSize"
        android:textColor="@color/text_night_main"
        android:gravity="center_vertical"
        android:id="@+id/remainOdometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888 km"
        app:layout_constraintStart_toEndOf="@+id/imageFuel"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/aurusTextSize"
        android:textColor="@color/text_night_main"
        android:gravity="center_vertical"
        android:id="@+id/odoTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888888 km"
        android:layout_marginEnd="520dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/remainOdometer"/>
    <TextView
        android:textSize="@dimen/aurusTextSize"
        android:textColor="@color/text_night_main"
        android:id="@+id/battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12.8V"
        app:layout_constraintStart_toEndOf="@+id/rightline"
        app:layout_constraintTop_toTopOf="@+id/odoTotal"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:src="@drawable/range_line_short"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/remainOdometer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
