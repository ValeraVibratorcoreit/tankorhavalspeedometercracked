<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="1442dp"
    android:layout_height="540dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/naviBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@android:color/transparent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/line_top"
        android:background="@drawable/line_top"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
    <ImageView
        android:background="@drawable/line_botton"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-14dp"
        app:layout_constraintBottom_toTopOf="@+id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/header_block_haval_h3_kia"/>
    <ru.zinovin.tankspeedometer.view.GradientCircleView
        android:id="@+id/leftMeterShadow"
        android:layout_width="480dp"
        android:layout_height="480dp"
        app:gradientColor="#f0000000"
        app:gradientStop="0.5"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"/>
    <ru.zinovin.tankspeedometer.view.GradientCircleView
        android:id="@+id/rightMeterShadow"
        android:layout_width="480dp"
        android:layout_height="480dp"
        app:gradientColor="#f0000000"
        app:gradientStop="0.5"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageLeftMeter"
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_marginTop="42dp"
        android:layout_marginStart="42dp"
        app:endAngle="394"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:maxValue="220"
        app:startAngle="146"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_speedTextFormat="INTEGER"
        app:sv_speedTextPosition="CENTER"
        app:sv_speedTextSize="90sp"
        app:sv_speedTextTypeface="fonts/vw_digit_reg.otf"
        app:sv_speedometerMode="NORMAL"
        app:sv_unit="km/h"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_unitTextSize="36sp"
        app:sv_unitUnderSpeedText="true"
        app:sv_withTremble="false"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/unit_text_kia"
        android:id="@+id/leftMeterText"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:text="km/h"
        android:fontFamily="@font/plau_medium"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:layout_constraintVertical_bias="0.65"/>
    <ru.zinovin.tankspeedometer.view.speedometer.SpeedometerView
        android:id="@+id/imageRightMeter"
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_marginEnd="42dp"
        app:endAngle="394"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"
        app:maxValue="8"
        app:startAngle="146"
        app:sv_speedTextColor="@android:color/transparent"
        app:sv_speedTextFormat="FLOAT"
        app:sv_speedTextPosition="CENTER"
        app:sv_speedTextSize="90sp"
        app:sv_speedTextTypeface="fonts/vw_digit_reg.otf"
        app:sv_speedometerMode="NORMAL"
        app:sv_unit="rpmx1000"
        app:sv_unitTextColor="@android:color/transparent"
        app:sv_unitTextSize="36sp"
        app:sv_unitUnderSpeedText="true"
        app:sv_withTremble="false"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/unit_text_kia"
        android:id="@+id/rightMeterText"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:text="x1000rpm"
        android:fontFamily="@font/plau_medium"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"
        app:layout_constraintVertical_bias="0.65"/>
    <FrameLayout
        android:id="@+id/leftLevelIndicator"
        android:layout_width="460dp"
        android:layout_height="460dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageLeftMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageLeftMeter"
        app:layout_constraintStart_toStartOf="@+id/imageLeftMeter"
        app:layout_constraintTop_toTopOf="@+id/imageLeftMeter"/>
    <FrameLayout
        android:id="@+id/rightLevelIndicator"
        android:layout_width="460dp"
        android:layout_height="460dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageRightMeter"
        app:layout_constraintEnd_toEndOf="@+id/imageRightMeter"
        app:layout_constraintStart_toStartOf="@+id/imageRightMeter"
        app:layout_constraintTop_toTopOf="@+id/imageRightMeter"/>
    <FrameLayout
        android:id="@+id/center_info_container"
        android:layout_width="300dp"
        android:layout_height="230dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@fraction/centerInfoPanelBias"/>
    <include
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/footer_block_haval_h3_kia"/>
</androidx.constraintlayout.widget.ConstraintLayout>
