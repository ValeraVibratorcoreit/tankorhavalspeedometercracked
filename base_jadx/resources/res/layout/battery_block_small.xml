<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/batCharE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="E"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/batteryIndicator"
        app:layout_constraintEnd_toStartOf="@+id/batteryIndicator"
        app:layout_constraintTop_toTopOf="@+id/batteryIndicator"/>
    <ru.zinovin.tankspeedometer.view.BatteryLevelIndicatorView
        android:id="@+id/batteryIndicator"
        android:layout_width="125dp"
        android:layout_height="@dimen/indicatorHeight"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/batCharF"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageBattery"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/battery"
        app:layout_constraintBottom_toTopOf="@+id/batteryIndicator"
        app:layout_constraintEnd_toEndOf="@+id/batteryIndicator"
        app:layout_constraintHorizontal_bias="0.11"
        app:layout_constraintStart_toStartOf="@+id/batteryIndicator"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/evRemainOdometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="888 km"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageBattery"
        app:layout_constraintStart_toEndOf="@+id/imageBattery"
        app:layout_constraintTop_toTopOf="@+id/imageBattery"
        app:layout_constraintVertical_bias="0.25"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/batCharF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="F"
        app:layout_constraintBottom_toBottomOf="@+id/batteryIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/batteryIndicator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
