<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@android:color/transparent"
    android:layout_width="1442dp"
    android:layout_height="540dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/naviBorder"
        android:layout_width="1440dp"
        android:layout_height="538dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:id="@+id/odoTotal"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="16dp"
        android:text="888888 km"
        android:layout_marginStart="308dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/wifiImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/wifi"
        android:layout_marginStart="652dp"
        app:layout_constraintBottom_toBottomOf="@+id/gear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gear"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textSize="@dimen/gearTextSize"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/gear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="0"
        android:layout_marginStart="740dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:id="@+id/battery"
        android:layout_width="98dp"
        android:layout_height="24dp"
        android:layout_marginBottom="1dp"
        android:text="bat  12.1V"
        app:layout_constraintBottom_toTopOf="@+id/evBattery"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:id="@+id/evBattery"
        android:layout_width="98dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:text="hv  48.8V"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:id="@+id/fuel"
        android:layout_width="108dp"
        android:layout_height="24dp"
        android:layout_marginBottom="16dp"
        android:text="50 L"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/rightline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="91dp"/>
    <TextView
        android:textSize="@dimen/textSize"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/coolant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="000 °C"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rightline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
