<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_bg_sidebar"/>
            <corners android:radius="8dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/ts_color_gwm"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_bg_sidebar"/>
            <corners android:radius="8dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/ts_color_text_secondary"/>
        </shape>
    </item>
</selector>
