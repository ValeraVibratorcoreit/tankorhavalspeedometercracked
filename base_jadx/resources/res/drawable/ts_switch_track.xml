<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_gwm"/>
            <corners android:radius="4dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/ts_color_gwm"/>
            <size
                android:height="64dp"
                android:width="112dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_control_off"/>
            <corners android:radius="4dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/ts_color_control_border"/>
            <size
                android:height="64dp"
                android:width="112dp"/>
        </shape>
    </item>
</selector>
