<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_gwm_soft" />
            <corners android:radius="@dimen/ts_card_radius" />
            <stroke android:width="2.0dp" android:color="@color/ts_color_gwm" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_gwm_soft" />
            <corners android:radius="@dimen/ts_card_radius" />
            <stroke android:width="2.0dp" android:color="@color/ts_color_gwm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_bg_panel" />
            <corners android:radius="@dimen/ts_card_radius" />
            <stroke android:width="1.0dp" android:color="@color/ts_color_divider" />
        </shape>
    </item>
</selector>
