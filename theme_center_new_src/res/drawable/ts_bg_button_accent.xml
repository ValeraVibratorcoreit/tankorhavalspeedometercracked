<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_gwm_pressed" />
            <corners android:radius="@dimen/ts_control_radius" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_text_disabled" />
            <corners android:radius="@dimen/ts_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_gwm" />
            <corners android:radius="@dimen/ts_control_radius" />
        </shape>
    </item>
</selector>
