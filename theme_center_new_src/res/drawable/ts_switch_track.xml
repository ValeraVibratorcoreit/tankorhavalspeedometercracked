<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_gwm" />
            <corners android:radius="4.0dp" />
            <stroke android:width="1.0dp" android:color="@color/ts_color_gwm" />
            <size android:height="64.0dp" android:width="112.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ts_color_control_off" />
            <corners android:radius="4.0dp" />
            <stroke android:width="1.0dp" android:color="@color/ts_color_control_border" />
            <size android:height="64.0dp" android:width="112.0dp" />
        </shape>
    </item>
</selector>
